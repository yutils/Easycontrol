<?xml version="1.0" encoding="utf-8"?><!-- 迷你悬浮窗：可拖拽的紧凑控制条 -->
<!-- 注意：本布局用 Application Context 膨胀(见 MiniView.java)，没有 AppCompat LayoutInflater Factory，
     所以图标染色只能用 android:tint，不能用 app:tint（后者不会被解析，图标会保持 VectorDrawable 原始黑色） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:ignore="UseAppTint">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spaceSm"
        android:background="@drawable/background_client_bar"
        android:elevation="@dimen/elevationLg"
        android:orientation="vertical"
        android:padding="@dimen/spaceSm">

        <ImageView
            android:id="@+id/button_small"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:background="@drawable/background_client_button"
            android:paddingStart="11dp"
            android:paddingTop="11dp"
            android:paddingEnd="11dp"
            android:paddingBottom="6dp"
            android:src="@drawable/window_restore"
            android:tint="@color/clientNavIcon" />

        <View
            android:layout_width="24dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spaceXs"
            android:layout_marginBottom="@dimen/spaceXs"
            android:background="@drawable/background_round"
            android:backgroundTint="@color/clientBar"
            android:focusable="false" />

        <ImageView
            android:id="@+id/button_full"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:background="@drawable/background_client_button"
            android:paddingStart="11dp"
            android:paddingTop="6dp"
            android:paddingEnd="11dp"
            android:paddingBottom="11dp"
            android:src="@drawable/expand"
            android:tint="@color/clientNavIcon" />

    </LinearLayout>

</FrameLayout>
