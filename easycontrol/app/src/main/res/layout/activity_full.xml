<?xml version="1.0" encoding="utf-8"?><!-- 投屏全屏页（竖屏）：视频画面 + 底部导航栏 + 浮动工具栏 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/blackBacnground"
    android:keepScreenOn="true"
    tools:context=".client.view.FullActivity">

    <EditText
        android:id="@+id/edit_text"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:inputType="textVisiblePassword" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- FrameLayout 以便绝对定位虚拟鼠标光标覆盖层；gravity=center 保持画面居中 -->
        <FrameLayout
            android:id="@+id/texture_view_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/nav_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:background="@drawable/background_client_nav"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spaceXs"
            android:paddingEnd="@dimen/spaceLg">

            <ImageView
                android:id="@+id/button_more"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/more"
                app:tint="@color/onBlackBacnground" />

            <ImageView
                android:id="@+id/button_switch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/square"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/o"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/caret_left"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_auto_rotate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/un_auto"
                app:tint="@color/clientNavIcon" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bar_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/spaceMd"
        android:layout_marginBottom="56dp"
        android:background="@drawable/background_client_bar"
        android:elevation="@dimen/elevationMd"
        android:orientation="vertical"
        android:padding="@dimen/spaceSm">

        <LinearLayout
            android:layout_width="168dp"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/button_app"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/share"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_mini"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/minus"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_small"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/window_restore"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_close"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/x"
                app:tint="@color/alert" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="168dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/spaceXs"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/button_rotate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/horizontal_rotate"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_nav_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/not_equal"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_power"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/power"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_light"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/lightbulb_off"
                app:tint="@color/clientNavIcon" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="168dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/spaceXs"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/button_mouse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/mouse"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_screenshot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/screenshot"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_volume"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="8dp"
                android:src="@drawable/volume_up"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_status"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/status"
                app:tint="@color/clientNavIcon" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/volume_bar"
            android:layout_width="168dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/spaceXs"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/image_volume_mute"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/volume_off"
                app:tint="@color/clientNavIcon" />

            <SeekBar
                android:id="@+id/seekbar_volume"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:progressTint="@color/onBlackBacnground"
                android:splitTrack="false"
                android:thumbTint="@color/onBlackBacnground" />

            <ImageView
                android:id="@+id/image_volume_max"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/volume_up"
                app:tint="@color/clientNavIcon" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
