<?xml version="1.0" encoding="utf-8"?><!-- 投屏全屏页（竖屏）：视频画面 + 底部导航栏 + 浮动工具栏 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blackBacnground"
    android:keepScreenOn="true"
    tools:context=".client.view.FullActivity">

    <EditText
        android:id="@+id/edit_text"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:inputType="textVisiblePassword" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/texture_view_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/nav_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:background="@drawable/background_client_nav"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="64dp"
            android:paddingEnd="@dimen/spaceLg">

            <ImageView
                android:id="@+id/button_switch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/square"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/o"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/caret_left"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_auto_rotate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/un_auto"
                android:tint="@color/clientNavIcon" />

        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/button_more"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/background_client_button"
        android:focusable="false"
        android:padding="12dp"
        android:src="@drawable/more"
        android:tint="@color/onBlackBacnground" />

    <LinearLayout
        android:id="@+id/bar_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/spaceMd"
        android:layout_marginBottom="56dp"
        android:background="@drawable/background_client_bar"
        android:elevation="@dimen/elevationMd"
        android:orientation="vertical"
        android:padding="@dimen/spaceSm">

        <LinearLayout
            android:layout_width="168dp"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/button_app"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/share"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_mini"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/minus"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_small"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/window_restore"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_close"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/x"
                android:tint="@color/alert" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="168dp"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/spaceXs"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/button_rotate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/horizontal_rotate"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_nav_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/not_equal"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_power"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/power"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_light"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/lightbulb_off"
                android:tint="@color/clientNavIcon" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
