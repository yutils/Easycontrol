<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_cron"
    android:orientation="vertical"
    android:padding="@dimen/cardPaddingH">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_device_title"
        android:textColor="@color/onCardBackground"
        android:textSize="@dimen/middleFont"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spaceMd"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/button_start_wireless"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/spaceSm"
            android:background="@drawable/background_button_primary"
            android:elevation="@dimen/elevationSm"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_device_button_start_wireless"
                android:textColor="@color/onButton"
                android:textSize="@dimen/smallFont"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/spaceSm"
                android:src="@drawable/rss"
                app:tint="@color/onButton" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/button_push_file"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="4"
                android:background="@drawable/background_button_secondary"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_device_buttons_send"
                    android:textColor="@color/onSecondaryContainer"
                    android:textSize="@dimen/smallFont"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/spaceSm"
                    android:src="@drawable/dir_floder"
                    app:tint="@color/onSecondaryContainer" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/button_recover"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="4"
                android:background="@drawable/background_button_secondary"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_device_button_recover"
                    android:textColor="@color/onSecondaryContainer"
                    android:textSize="@dimen/smallFont"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/spaceSm"
                    android:src="@drawable/refresh"
                    app:tint="@color/onSecondaryContainer" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spaceSm"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/button_change"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="4"
                android:background="@drawable/background_button_secondary"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_device_button_change"
                    android:textColor="@color/onSecondaryContainer"
                    android:textSize="@dimen/smallFont"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/spaceSm"
                    android:src="@drawable/editor"
                    app:tint="@color/onSecondaryContainer" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/button_delete"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="4"
                android:background="@drawable/background_button_alert"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_device_button_delete"
                    android:textColor="@color/onAlert"
                    android:textSize="@dimen/smallFont"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="@dimen/spaceSm"
                    android:src="@drawable/ashbin"
                    app:tint="@color/onAlert" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
