<?xml version="1.0" encoding="utf-8"?><!-- 小窗悬浮窗：可拖拽的视频画面 + 导航栏 + 浮动工具栏 -->
<!-- 注意：本布局用 Application Context 膨胀(见 SmallView.java)，没有 AppCompat LayoutInflater Factory，
     所以图标染色只能用 android:tint，不能用 app:tint（后者不会被解析，图标会保持 VectorDrawable 原始黑色） -->
<top.saymzx.easycontrol.app.client.view.MyViewForSmallView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:ignore="UseAppTint">

    <EditText
        android:id="@+id/edit_text"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="50dp"
        android:inputType="textVisiblePassword" />

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_margin="@dimen/spaceSm"
        android:background="@drawable/background_cron"
        android:elevation="@dimen/elevationMd"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/texture_view_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/nav_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/blackBacnground"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spaceLg"
            android:paddingEnd="@dimen/spaceLg"
            tools:ignore="RtlSymmetry">

            <ImageView
                android:id="@+id/button_switch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/square"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/o"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/caret_left"
                android:tint="@color/clientNavIcon" />

        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bar"
        android:layout_width="130dp"
        android:layout_height="32dp"
        android:layout_gravity="top|center_horizontal"
        android:elevation="@dimen/elevationLg">

        <View
            android:layout_width="76dp"
            android:layout_height="6dp"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="@dimen/spaceSm"
            android:background="@drawable/background_round"
            android:backgroundTint="@color/clientBar"
            android:focusable="false" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bar_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="36dp"
        android:background="@drawable/background_client_bar"
        android:elevation="@dimen/elevationLg"
        android:orientation="vertical"
        android:padding="@dimen/spaceSm">

        <LinearLayout
            android:layout_width="152dp"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/button_app"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/share"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_mini"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/minus"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_full"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/expand"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_close"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/x"
                android:tint="@color/alert" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="152dp"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/spaceXs"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/button_rotate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/horizontal_rotate"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_nav_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/not_equal"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_power"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/power"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_light"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/lightbulb_off"
                android:tint="@color/clientNavIcon" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="152dp"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/spaceXs"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/button_mouse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/mouse"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_screenshot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/screenshot"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_volume"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="6dp"
                android:src="@drawable/volume_up"
                android:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_status"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/status"
                android:tint="@color/clientNavIcon" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/volume_bar"
            android:layout_width="152dp"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/spaceXs"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/image_volume_mute"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/volume_off"
                android:tint="@color/clientNavIcon" />

            <SeekBar
                android:id="@+id/seekbar_volume"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:progressTint="@color/onBlackBacnground"
                android:splitTrack="false"
                android:thumbTint="@color/onBlackBacnground" />

            <ImageView
                android:id="@+id/image_volume_max"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="false"
                android:padding="9dp"
                android:src="@drawable/volume_up"
                android:tint="@color/clientNavIcon" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/re_size"
        android:layout_width="32dp"
        android:layout_height="40dp"
        android:layout_gravity="end|bottom"
        android:focusable="false" />

</top.saymzx.easycontrol.app.client.view.MyViewForSmallView>
